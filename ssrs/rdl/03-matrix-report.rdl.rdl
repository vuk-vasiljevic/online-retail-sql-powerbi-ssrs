  <DataSources>
    <DataSource Name="DataSource1">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost\SQLEXPRESS03;Initial Catalog=OnlineRetailII</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>4a9735dc-8703-4b11-b025-7475eb58189c</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DS_Matrix">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT 
    Country,
    YEAR(InvoiceDate) AS InvoiceYear,
    MONTH(InvoiceDate) AS InvoiceMonth,
    Quantity * UnitPrice AS LineTotal
FROM dbo.OnlineRetailClean
WHERE InvoiceDate IS NOT NULL
</CommandText>
      </Query>
      <Fields>
        <Field Name="Country">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Country</DataField>
        </Field>
        <Field Name="InvoiceYear">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>InvoiceYear</DataField>
        </Field>
        <Field Name="InvoiceMonth">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>InvoiceMonth</DataField>
        </Field>
        <Field Name="LineTotal">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>LineTotal</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
