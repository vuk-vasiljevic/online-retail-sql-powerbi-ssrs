  <DataSources>
    <DataSource Name="DataSource1">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost\SQLEXPRESS03;Initial Catalog=OnlineRetailII</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>0d27c1fd-8f06-48cf-b019-d0cdd9068a6d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DS_Param">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Country">
            <Value>=Parameters!Country.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
    [Invoice],
    [StockCode],
    [Description],
    [Quantity],
    [Price],
    [Country]
FROM [dbo].[online_retail_II$]
WHERE [Country] = @Country</CommandText>
      </Query>
      <Fields>
        <Field Name="Invoice">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>Invoice</DataField>
        </Field>
        <Field Name="StockCode">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>StockCode</DataField>
        </Field>
        <Field Name="Description">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Description</DataField>
        </Field>
        <Field Name="Quantity">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>Quantity</DataField>
        </Field>
        <Field Name="Price">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>Price</DataField>
        </Field>
        <Field Name="Country">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Country</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DS_Countries">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT DISTINCT [Country]
FROM [dbo].[online_retail_II$]
WHERE [Country] IS NOT NULL
ORDER BY [Country]
</CommandText>
      </Query>
      <Fields>
        <Field Name="Country">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Country</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
