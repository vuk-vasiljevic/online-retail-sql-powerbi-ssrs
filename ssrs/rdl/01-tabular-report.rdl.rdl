  <DataSources>
    <DataSource Name="DataSource1">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost\sqlexpress03;Initial Catalog=OnlineRetailII</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>9fa99e96-11b2-4f2e-abff-d61f154532d8</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SELECT TOP (50)
    InvoiceNo,
    InvoiceDate,
    Country,
    Quantity,
    UnitPrice,
    (Quantity * UnitPrice) AS Revenue
FROM dbo.OnlineRetailClean
ORDER BY InvoiceDate DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="InvoiceNo">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>InvoiceNo</DataField>
        </Field>
        <Field Name="InvoiceDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>InvoiceDate</DataField>
        </Field>
        <Field Name="Country">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Country</DataField>
        </Field>
        <Field Name="Quantity">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Quantity</DataField>
        </Field>
        <Field Name="UnitPrice">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>UnitPrice</DataField>
        </Field>
        <Field Name="Revenue">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Revenue</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
