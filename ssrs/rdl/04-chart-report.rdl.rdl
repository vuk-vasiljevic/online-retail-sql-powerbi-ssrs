  <DataSources>
    <DataSource Name="DataSource1">
      <rd:SecurityType>Integrated</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost\SQLEXPRESS03;Initial Catalog=OnlineRetailII</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:DataSourceID>8a5bf91a-6d30-43cd-af12-8703834b2999</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DS_Chart">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT TOP 10
    Country,
    SUM(CAST(Quantity AS decimal(18,4)) * Price) AS TotalSales
FROM dbo.[online_retail_II$]
WHERE Country IS NOT NULL
GROUP BY Country
ORDER BY TotalSales DESC;
</CommandText>
      </Query>
      <Fields>
        <Field Name="Country">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Country</DataField>
        </Field>
        <Field Name="TotalSales">
          <rd:TypeName>System.Double</rd:TypeName>
          <DataField>TotalSales</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
